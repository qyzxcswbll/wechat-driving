<view class="page">
  <view wx:if="{{list.length===0}}" class="empty">
    <text class="empty-icon">🙋</text>
    <text class="empty-text">暂无参观咨询</text>
  </view>
  <view wx:for="{{list}}" wx:key="_id" class="card">
    <view class="card-top">
      <text class="card-name">{{item.nickName || '未留名'}}</text>
      <status-badge status="{{item.status}}" />
    </view>
    <view class="card-info">📱 {{item.phone}}</view>
    <view wx:if="{{item.remark}}" class="card-info">💬 {{item.remark}}</view>
    <view class="card-time">🕐 {{item.createdAt}}</view>
    <view wx:if="{{item.status==='pending'}}" class="action-row">
      <view class="btn-done" bindtap="markDone" data-id="{{item._id}}">✅ 标记已联系</view>
      <view class="btn-call" bindtap="callPhone" data-phone="{{item.phone}}">📞 打电话</view>
    </view>
  </view>
</view>
<nav-bar activeTab="visits" items="{{navItems}}" />
