.splash {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #fff;
  padding: 0 60rpx;
}
.splash-icon { font-size: 96rpx; margin-bottom: 20rpx; }
.splash-title { font-size: 40rpx; font-weight: 600; color: #3C3489; margin-bottom: 12rpx; }
.splash-sub { font-size: 26rpx; color: #888; margin-bottom: 80rpx; }
.login-box { text-align: center; width: 100%; }
.login-btn { background: #534AB7; color: #fff; padding: 28rpx; border-radius: 20rpx; font-size: 32rpx; font-weight: 500; width: 100%; border: none; }
.login-btn::after { border: none; }
.login-desc { font-size: 24rpx; color: #999; margin-top: 20rpx; }
.notify-box { text-align: center; width: 100%; }
.notify-text { font-size: 26rpx; color: #555; margin-bottom: 32rpx; line-height: 1.6; }
.notify-btn { background: #534AB7; color: #fff; padding: 28rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 500; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; }
.skip-btn { font-size: 26rpx; color: #999; padding: 16rpx; text-align: center; }