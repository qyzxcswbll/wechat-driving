.page { padding: 28rpx; width: 100%; box-sizing: border-box; }
.card { background: #fff; border-radius: 22rpx; padding: 28rpx; border: 2rpx solid #e8e8e8; width: 100%; box-sizing: border-box; }
.field { margin-bottom: 28rpx; width: 100%; }
.field:last-child { margin-bottom: 0; }
.field-label { font-size: 24rpx; color: #888; margin-bottom: 10rpx; }
.field-label .required { color: #A32D2D; }
.name-row { display: flex; gap: 14rpx; align-items: center; }
.name-input { flex: 1; background: #fff; border: 2rpx solid #ddd; border-radius: 14rpx; padding: 24rpx 24rpx; font-size: 28rpx; color: #333; display: block; width: 100%; box-sizing: border-box; min-height: 76rpx; }
.gender-tag { padding: 14rpx 24rpx; border-radius: 12rpx; font-size: 24rpx; background: #f8f8f8; color: #666; border: 2rpx solid #e8e8e8; display: flex; align-items: center; flex-shrink: 0; }
.gender-tag.on { background: #534AB7; color: #fff; border-color: #534AB7; }
.field-input { background: #fff; border: 2rpx solid #ddd; border-radius: 14rpx; padding: 24rpx 24rpx; font-size: 28rpx; color: #333; display: block; width: 100%; box-sizing: border-box; min-height: 76rpx; }
.field-text { background: #f8f8f8; border: 2rpx solid #e8e8e8; border-radius: 14rpx; padding: 24rpx 24rpx; font-size: 28rpx; color: #555; width: 100%; box-sizing: border-box; min-height: 76rpx; display: flex; align-items: center; }
.pill-group { display: flex; gap: 14rpx; width: 100%; }
.pill { flex: 1; padding: 18rpx; border-radius: 14rpx; text-align: center; font-size: 26rpx; background: #f8f8f8; color: #666; border: 2rpx solid #e8e8e8; min-height: 68rpx; display: flex; align-items: center; justify-content: center; }
.pill.on { background: #534AB7; color: #fff; border-color: #534AB7; }
.section-title { font-size: 28rpx; font-weight: 500; color: #333; margin: 28rpx 0 16rpx; }
.slot-card { background: #fff; border-radius: 22rpx; padding: 24rpx; border: 2rpx solid #e8e8e8; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; }
.slot-row { display: flex; gap: 14rpx; margin-bottom: 14rpx; width: 100%; }
.picker-btn { flex: 1; background: #f8f8f8; border: 2rpx solid #ddd; border-radius: 14rpx; padding: 20rpx 16rpx; font-size: 26rpx; color: #333; text-align: center; min-height: 72rpx; display: flex; align-items: center; justify-content: center; }
.slot-remark-row { display: flex; align-items: center; gap: 14rpx; width: 100%; }
.slot-remark-row .field-input { flex: 1; padding: 20rpx 24rpx; min-height: 72rpx; }
.slot-del { color: #A32D2D; font-size: 22rpx; flex-shrink: 0; padding: 14rpx 0; }
.add-slot { border: 2rpx dashed #ccc; border-radius: 16rpx; padding: 20rpx; text-align: center; font-size: 26rpx; color: #888; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; }
.btn-primary { background: #534AB7; color: #fff; padding: 22rpx; border-radius: 16rpx; text-align: center; font-size: 28rpx; font-weight: 500; width: 100%; border: none; display: block; box-sizing: border-box; min-height: 72rpx; line-height: 1.2; }
.btn-primary::after { border: none; }
.btn-primary.btn-disabled { background: #ccc; }
.privacy-row { margin-top: 16rpx; padding: 14rpx 0; }
.privacy-checkbox { display: flex; align-items: center; gap: 10rpx; }
.check-box { width: 28rpx; height: 28rpx; border-radius: 6rpx; border: 2rpx solid #ccc; display: flex; align-items: center; justify-content: center; font-size: 18rpx; color: #fff; flex-shrink: 0; }
.check-box.checked { background: #534AB7; border-color: #534AB7; }
.privacy-text { font-size: 22rpx; color: #666; }
.privacy-link { color: #534AB7; text-decoration: underline; }
.hint { font-size: 22rpx; color: #aaa; margin-top: 10rpx; }
