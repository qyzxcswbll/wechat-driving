.page { padding: 0 0 140rpx; }
.header { font-size: 44rpx; font-weight: 700; color: #1a1a1a; padding: 32rpx 32rpx 0; margin-bottom: 8rpx; }

/* 日期条 */
.date-section { padding: 16rpx 24rpx 24rpx; }
.date-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.week-label { font-size: 26rpx; font-weight: 600; color: #333; }
.month-picker { font-size: 24rpx; color: #0F6E56; background: #E1F5EE; padding: 12rpx 24rpx; border-radius: 16rpx; }
.date-strip { white-space: nowrap; }
.date-card { display: inline-flex; flex-direction: column; align-items: center; width: 110rpx; padding: 20rpx 0; margin: 0 5rpx; border-radius: 20rpx; background: #fff; border: 3rpx solid #e8e8e8; }
.date-card.active { background: #0F6E56; border-color: #0F6E56; }
.date-card.today:not(.active) { background: #E1F5EE; border-color: #9FE1CB; }
.dc-dow { font-size: 22rpx; color: #999; margin-bottom: 6rpx; }
.date-card.active .dc-dow { color: rgba(255,255,255,.7); }
.date-card.today:not(.active) .dc-dow { color: #0F6E56; }
.dc-day { font-size: 34rpx; font-weight: 700; color: #222; margin-bottom: 6rpx; }
.date-card.active .dc-day { color: #fff; }
.date-card.today:not(.active) .dc-day { color: #0F6E56; }
.dc-count { font-size: 20rpx; color: #fff; background: #0F6E56; padding: 2rpx 16rpx; border-radius: 14rpx; }
.date-card.active .dc-count { background: rgba(255,255,255,.25); }
.date-card.today:not(.active) .dc-count { background: #0F6E56; }
.dc-count.empty { background: transparent; color: #ccc; }

/* 课程区域 */
.course-section { padding: 0 32rpx; }
.selected-date { font-size: 26rpx; color: #666; font-weight: 500; margin-bottom: 24rpx; }

/* 空状态 */
.empty-state { text-align: center; padding: 100rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #aaa; }

/* 时间段分组 */
.time-group { margin-bottom: 28rpx; }
.time-header { font-size: 28rpx; font-weight: 600; color: #0F6E56; margin-bottom: 16rpx; display: flex; align-items: center; gap: 8rpx; }
.time-count { font-size: 24rpx; color: #888; font-weight: 400; }

/* 学员标签 */
.student-tag-wrap { display: flex; flex-wrap: wrap; gap: 12rpx; }
.student-tag { background: #f8f8f8; border: 2rpx solid #e8e8e8; border-radius: 28rpx; padding: 16rpx 28rpx; }
.tag-name { font-size: 28rpx; font-weight: 500; color: #333; }

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-box { background: #fff; border-radius: 28rpx; width: 620rpx; padding: 36rpx 32rpx; }
.modal-hd { font-size: 34rpx; font-weight: 600; color: #222; text-align: center; margin-bottom: 24rpx; }
.modal-body { border-top: 2rpx solid #f0f0f0; }
.modal-row { display: flex; padding: 22rpx 0; border-bottom: 2rpx solid #f0f0f0; font-size: 28rpx; }
.modal-row:last-child { border-bottom: none; }
.ml { color: #888; width: 140rpx; flex-shrink: 0; }
.mv { color: #333; }
.modal-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.modal-btn { flex: 1; padding: 22rpx; border-radius: 18rpx; text-align: center; font-size: 30rpx; font-weight: 500; }
.modal-btn.call { background: #0F6E56; color: #fff; }
.modal-btn.close { background: #f0f0f0; color: #555; }