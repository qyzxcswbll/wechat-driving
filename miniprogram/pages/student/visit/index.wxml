<view class="page" style="padding:16px;">
  <view class="card" style="background:#fff;border-radius:12px;padding:14px;border:1px solid #e8e8e8;">
    <view style="margin-bottom:14px;">
      <view style="font-size:12px;color:#888;margin-bottom:4px;">微信昵称</view>
      <view style="background:#f8f8f8;border:1px solid #e8e8e8;border-radius:8px;padding:10px;font-size:14px;color:#555;">{{nickName}}</view>
    </view>
    <view style="margin-bottom:14px;">
      <view style="font-size:12px;color:#888;margin-bottom:4px;">手机号 <text style="color:#A32D2D;">*</text></view>
      <input style="background:#fff;border:1px solid #ddd;border-radius:8px;padding:10px;font-size:14px;color:#333;width:100%;box-sizing:border-box;" placeholder="请输入手机号" bindinput="onPhoneInput" />
    </view>
    <view style="margin-bottom:14px;">
      <view style="font-size:12px;color:#888;margin-bottom:4px;">备注（可选）</view>
      <input style="background:#fff;border:1px solid #ddd;border-radius:8px;padding:10px;font-size:14px;color:#333;width:100%;box-sizing:border-box;" placeholder="有什么想了解的？" bindinput="onRemarkInput" />
    </view>
  </view>
  <view style="background:#534AB7;color:#fff;padding:14px;border-radius:10px;text-align:center;font-size:15px;font-weight:500;margin-top:16px;" bindtap="submit">提交参观申请</view>
  <view style="font-size:12px;color:#aaa;text-align:center;margin-top:10px;">提交后教练会主动联系您约时间参观</view>
</view>
