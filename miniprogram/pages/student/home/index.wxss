.page { padding: 32rpx 28rpx 140rpx; }
.hero { background: linear-gradient(135deg, #EEEDFE, #F8F7FF); border-radius: 28rpx; padding: 48rpx 32rpx; text-align: center; margin-bottom: 24rpx; border: 2rpx solid #CECBF6; }
.hero-title { font-size: 44rpx; font-weight: 600; color: #3C3489; margin-bottom: 8rpx; }
.hero-sub { font-size: 28rpx; color: #7F77DD; }

.section-card { background: #fff; border-radius: 24rpx; padding: 28rpx; border: 2rpx solid #e8e8e8; margin-bottom: 24rpx; }
.section-title { font-size: 26rpx; color: #999; margin-bottom: 16rpx; padding-bottom: 16rpx; border-bottom: 2rpx solid #f0f0f0; display: flex; align-items: center; gap: 8rpx; }
.info-row { display: flex; padding: 10rpx 0; font-size: 28rpx; }
.info-row:last-child { padding-bottom: 0; }
.info-label { color: #888; width: 120rpx; flex-shrink: 0; }
.info-val { color: #333; }

.menu-section { background: #fff; border-radius: 24rpx; border: 2rpx solid #e8e8e8; overflow: hidden; }
.menu-grid { display: flex; flex-wrap: wrap; }
.menu-item { width: 50%; padding: 36rpx 16rpx; text-align: center; box-sizing: border-box; border-right: 2rpx solid #f0f0f0; border-bottom: 2rpx solid #f0f0f0; }
.menu-item:nth-child(even) { border-right: none; }
.menu-item:nth-last-child(-n+2) { border-bottom: none; }
.menu-icon { display: block; font-size: 48rpx; margin-bottom: 8rpx; }
.menu-label { font-size: 26rpx; color: #555; }
.setup-entry { position: fixed; bottom: 160rpx; right: 20rpx; font-size: 36rpx; opacity: 0.4; padding: 16rpx; z-index: 200; }
