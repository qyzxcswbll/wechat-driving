.page { padding: 32rpx 32rpx 140rpx; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #888; }
.booking-card { background: #fff; border-radius: 24rpx; padding: 28rpx; border: 2rpx solid #e8e8e8; margin-bottom: 20rpx; }
.booking-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.booking-date { font-size: 28rpx; font-weight: 500; color: #333; }
.booking-info { font-size: 26rpx; color: #666; }
