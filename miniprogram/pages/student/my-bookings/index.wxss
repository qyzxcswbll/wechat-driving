.page { padding: 32rpx 32rpx 140rpx; }
.tab-bar { display: flex; background: #f0f0f0; border-radius: 16rpx; padding: 6rpx; margin-bottom: 32rpx; }
.tab { flex: 1; padding: 18rpx; text-align: center; font-size: 26rpx; color: #888; border-radius: 12rpx; }
.tab.on { background: #fff; color: #534AB7; font-weight: 500; }
.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #888; }
.booking-card { background: #fff; border-radius: 24rpx; padding: 28rpx; border: 2rpx solid #e8e8e8; margin-bottom: 20rpx; }
.booking-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.booking-date { font-size: 28rpx; font-weight: 500; color: #333; }
.booking-info { font-size: 26rpx; color: #666; margin-bottom: 4rpx; }
.booking-time { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.cancel-btn { margin-top: 16rpx; padding: 16rpx; text-align: center; font-size: 24rpx; color: #A32D2D; border: 2rpx solid #A32D2D; border-radius: 12rpx; }
.notify-bar { margin-top: 24rpx; padding: 24rpx; text-align: center; font-size: 24rpx; color: #534AB7; background: #f8f8f8; border-radius: 16rpx; }
