<view class="page" style="padding:16px;">
  <view class="card" style="background:#fff;border-radius:12px;padding:24px;border:1px solid #e8e8e8;text-align:center;margin-bottom:12px;">
    <view style="font-size:18px;font-weight:500;color:#333;margin-bottom:16px;">👨‍🏫 {{info.coachName}}</view>
    <view wx:if="{{info.wechatQR}}" style="margin-bottom:8px;">
      <image src="{{info.wechatQR}}" mode="widthFix" style="width:180px;border-radius:8px;" />
    </view>
    <view wx:else style="background:#f5f5f5;border-radius:8px;padding:40px;margin-bottom:8px;color:#999;font-size:13px;">微信二维码</view>
    <view style="font-size:12px;color:#888;margin-bottom:16px;">长按识别二维码添加微信</view>
    <view style="background:#f8f8f8;border:1px solid #e8e8e8;border-radius:8px;padding:10px;margin-bottom:12px;text-align:center;" bindtap="copyWechat">📋 复制微信号</view>
    <contact-button type="default-light" size="20" session-from="平安驾校咨询"></contact-button>
  </view>
  <view class="card" style="background:#fff;border-radius:12px;padding:16px;border:1px solid #e8e8e8;text-align:center;">
    <view style="background:#534AB7;color:#fff;padding:14px;border-radius:10px;font-size:14px;font-weight:500;" bindtap="callPhone" data-phone="{{info.phone}}">📞 拨打电话</view>
  </view>
</view>
