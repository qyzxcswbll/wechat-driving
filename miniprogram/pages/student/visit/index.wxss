.page { padding: 32rpx 32rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; border: 2rpx solid #e8e8e8; }
.field { margin-bottom: 32rpx; }
.field:last-child { margin-bottom: 0; }
.field-label { font-size: 24rpx; color: #888; margin-bottom: 12rpx; }
.field-label .required { color: #A32D2D; }
.field-input { background: #fff; border: 2rpx solid #ddd; border-radius: 16rpx; padding: 24rpx 28rpx; font-size: 28rpx; color: #333; width: 100%; box-sizing: border-box; }
.field-text { background: #f8f8f8; border: 2rpx solid #e8e8e8; border-radius: 16rpx; padding: 24rpx 28rpx; font-size: 28rpx; color: #555; }
.btn-primary { background: #534AB7; color: #fff; padding: 28rpx; border-radius: 20rpx; text-align: center; font-size: 30rpx; font-weight: 500; margin-top: 32rpx; width: 100%; border: none; }
.btn-primary::after { border: none; }
.hint { font-size: 24rpx; color: #aaa; text-align: center; margin-top: 20rpx; }