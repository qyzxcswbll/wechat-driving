.card { background: #fff; border-radius: 22rpx; padding: 28rpx; border: 2rpx solid #e8e8e8; width: 100%; box-sizing: border-box; }
.field { margin-bottom: 28rpx; width: 100%; }
.field-label { font-size: 24rpx; color: #888; margin-bottom: 10rpx; }
.field-input { background: #fff; border: 2rpx solid #ddd; border-radius: 14rpx; padding: 24rpx 24rpx; font-size: 28rpx; color: #333; display: block; width: 100%; box-sizing: border-box; min-height: 76rpx; }
.sect-title { font-size: 28rpx; font-weight: 500; color: #333; margin-bottom: 8rpx; }
.btn-primary { background: #534AB7; color: #fff; padding: 22rpx; border-radius: 16rpx; text-align: center; font-size: 28rpx; font-weight: 500; width: 100%; border: none; display: block; box-sizing: border-box; min-height: 72rpx; margin-top: 16rpx; }
.btn-primary::after { border: none; }
.set-btn { background: #E1F5EE; color: #0F6E56; padding: 10rpx 24rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: 500; flex-shrink: 0; }
.remove-btn { background: #FAEEDA; color: #BA7517; padding: 10rpx 24rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: 500; flex-shrink: 0; }
.load-more { text-align: center; padding: 20rpx; font-size: 24rpx; color: #534AB7; margin-top: 8rpx; }
.upload-btn { background: #f0f0f0; color: #555; padding: 14rpx 20rpx; border-radius: 12rpx; font-size: 22rpx; border: none; flex-shrink: 0; }
.upload-btn::after { border: none; }
.q-help { font-size: 26rpx; margin-left: 8rpx; }

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-box { background: #fff; border-radius: 28rpx; width: 620rpx; padding: 36rpx 32rpx; }
.modal-hd { font-size: 32rpx; font-weight: 600; color: #222; text-align: center; margin-bottom: 24rpx; }
.modal-body { margin-bottom: 8rpx; }
.qr-step { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 20rpx; }
.qr-step-num { width: 40rpx; height: 40rpx; background: #534AB7; color: #fff; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 24rpx; font-weight: 600; flex-shrink: 0; margin-top: 2rpx; }
.qr-step-text { font-size: 28rpx; color: #333; line-height: 1.6; }
.modal-close { margin-top: 20rpx; padding: 22rpx; text-align: center; font-size: 28rpx; color: #534AB7; font-weight: 500; background: #f0f0f0; border-radius: 16rpx; }