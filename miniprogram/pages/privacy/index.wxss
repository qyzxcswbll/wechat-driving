.page { padding: 32rpx; width: 100%; box-sizing: border-box; background: #f5f5f7; min-height: 100vh; }
.card { background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; border: 2rpx solid #e8e8e8; }
.title { font-size: 36rpx; font-weight: 600; color: #333; text-align: center; margin-bottom: 12rpx; }
.updated { font-size: 22rpx; color: #999; text-align: center; margin-bottom: 40rpx; }
.section { margin-bottom: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 500; color: #333; margin-bottom: 12rpx; padding-left: 8rpx; border-left: 6rpx solid #534AB7; padding-left: 16rpx; }
.section-body { padding-left: 8rpx; }
.item { font-size: 26rpx; color: #555; line-height: 1.7; margin-bottom: 6rpx; }
.bold { font-weight: 500; color: #333; }
