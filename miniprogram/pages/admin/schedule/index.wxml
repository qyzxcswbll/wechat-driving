<view class="page" style="padding:16px 16px 70px;">
  <view style="background:#fff;border-radius:12px;padding:14px;border:1px solid #e8e8e8;">
    <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <text style="font-size:18px;font-weight:500;color:#333;" bindtap="prevWeek">‹</text>
      <text style="font-size:14px;color:#0F6E56;font-weight:500;">{{weekLabel}}</text>
      <text style="font-size:18px;font-weight:500;color:#333;" bindtap="nextWeek">›</text>
    </view>
    <view style="display:flex;gap:4px;">
      <view wx:for="{{weekDays}}" wx:key="index"
        style="flex:1;padding:8px 2px;text-align:center;font-size:11px;border-radius:6px;{{item.active?'background:#0F6E56;color:#fff;':item.isToday?'background:#E1F5EE;color:#0F6E56;border:1px solid #9FE1CB;':'background:#f8f8f8;color:#666;border:1px solid #e8e8e8;'}}"
        bindtap="selectDay" data-date="{{item.date}}">
        <text style="display:block;">{{item.dow}}</text>
        <text style="display:block;margin-top:2px;font-size:12px;font-weight:{{item.active?'600':'400'}};">{{item.day}}</text>
      </view>
    </view>
  </view>

  <view style="font-size:15px;font-weight:500;color:#333;margin:16px 0 10px;">{{selectedDate}} 课程</view>

  <view wx:if="{{!daySchedule || daySchedule.length===0}}" style="background:#fff;border-radius:12px;padding:40px;text-align:center;border:1px solid #e8e8e8;">
    <text style="font-size:40px;display:block;margin-bottom:8px;">📅</text>
    <text style="font-size:14px;color:#888;">当天暂无课程</text>
  </view>

  <view wx:for="{{daySchedule}}" wx:key="_id" style="background:#E1F5EE;padding:12px;border-radius:8px;margin-bottom:6px;border-left:4px solid #0F6E56;display:flex;align-items:center;gap:10px;">
    <text style="font-size:13px;font-weight:500;color:#085041;flex-shrink:0;">{{item.time}}</text>
    <text style="font-size:13px;color:#333;">{{item.nickName}} · {{item.subject}}</text>
  </view>
</view>
<nav-bar activeTab="schedule" items="{{navItems}}" />
