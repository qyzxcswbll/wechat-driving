<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">称呼 <text class="required">*</text></view>
      <view class="name-row">
        <input class="name-input" placeholder="您的昵称" value="{{nickName}}" bindinput="onNameInput" />
        <view class="gender-tag {{gender==='先生'?'on':''}}" bindtap="setGender" data-val="先生">先生</view>
        <view class="gender-tag {{gender==='女士'?'on':''}}" bindtap="setGender" data-val="女士">女士</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">手机号 <text class="required">*</text></view>
      <input class="field-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
  </view>
  <view class="card" style="margin-top:24rpx;">
    <view class="field">
      <view class="field-label">学车类型</view>
      <view class="pill-group">
        <view class="pill {{subject==='科目二'?'on':''}}" bindtap="setSubject" data-val="科目二">科目二</view>
        <view class="pill {{subject==='科目三'?'on':''}}" bindtap="setSubject" data-val="科目三">科目三</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">挡位类型</view>
      <view class="pill-group">
        <view class="pill {{gear==='自动挡'?'on':''}}" bindtap="setGear" data-val="自动挡">🔄 自动挡</view>
        <view class="pill {{gear==='手动挡'?'on':''}}" bindtap="setGear" data-val="手动挡">⚙️ 手动挡</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">备注（可选）</view>
      <input class="field-input" placeholder="其他想说明的" bindinput="onRemarkInput" />
    </view>
  </view>

  <view class="section-title">预约日期</view>

  <view wx:for="{{slots}}" wx:key="index" class="slot-card">
    <view class="slot-row">
      <picker mode="date" value="{{item.date}}" bindchange="onDateChange" data-index="{{index}}">
        <view class="picker-btn">{{item.dateDisplay}}</view>
      </picker>
      <picker mode="time" value="{{item.time}}" bindchange="onTimeChange" data-index="{{index}}">
        <view class="picker-btn">{{item.timeDisplay}}</view>
      </picker>
    </view>
    <view class="slot-remark-row">
      <input class="field-input" placeholder="备注（可选）" value="{{item.remark}}" bindinput="onSlotRemark" data-index="{{index}}" />
      <view wx:if="{{slots.length>1}}" class="slot-del" bindtap="removeSlot" data-index="{{index}}">删除</view>
    </view>
  </view>

  <view class="add-slot" bindtap="addSlot">+ 再添加一个日期</view>
  <view class="privacy-row">
    <label class="privacy-checkbox" bindtap="togglePrivacy">
      <view class="check-box {{agreed?'checked':''}}">{{agreed?'✓':''}}</view>
      <text class="privacy-text">我已阅读并同意 <text class="privacy-link" bindtap="openPrivacy" catchtap>《隐私政策》</text></text>
    </label>
  </view>
  <button class="btn-primary {{!agreed?'btn-disabled':''}}" disabled="{{!agreed}}" bindtap="submit">一次性提交所有预约（{{slots.length}}节）</button>
</view>
