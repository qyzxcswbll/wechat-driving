<view class="page" style="padding:16px 16px 70px;">
  <view style="display:flex;gap:8px;margin-bottom:16px;">
    <view style="flex:1;background:#FAEEDA;border-radius:10px;padding:14px;text-align:center;">
      <view style="font-size:24px;font-weight:600;color:#633806;">{{pendingCount}}</view>
      <view style="font-size:11px;color:#BA7517;margin-top:4px;">待处理预约</view>
    </view>
    <view style="flex:1;background:#E1F5EE;border-radius:10px;padding:14px;text-align:center;">
      <view style="font-size:24px;font-weight:600;color:#085041;">{{visitCount}}</view>
      <view style="font-size:11px;color:#0F6E56;margin-top:4px;">参观咨询</view>
    </view>
    <view style="flex:1;background:#E1F5EE;border-radius:10px;padding:14px;text-align:center;">
      <view style="font-size:24px;font-weight:600;color:#085041;">{{confirmedCount}}</view>
      <view style="font-size:11px;color:#0F6E56;margin-top:4px;">已确认</view>
    </view>
  </view>

  <view style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">
    <view style="background:#E1F5EE;border:1px solid #9FE1CB;border-radius:10px;padding:16px;text-align:center;" bindtap="goTo" data-url="../visits/index">
      <text style="display:block;font-size:24px;margin-bottom:6px;">🙋</text>
      <text style="font-size:12px;color:#085041;">咨询学员</text>
    </view>
    <view style="background:#E1F5EE;border:1px solid #9FE1CB;border-radius:10px;padding:16px;text-align:center;" bindtap="goTo" data-url="../bookings/index">
      <text style="display:block;font-size:24px;margin-bottom:6px;">📋</text>
      <text style="font-size:12px;color:#085041;">预约管理</text>
    </view>
    <view style="background:#E1F5EE;border:1px solid #9FE1CB;border-radius:10px;padding:16px;text-align:center;" bindtap="goTo" data-url="../schedule/index">
      <text style="display:block;font-size:24px;margin-bottom:6px;">📅</text>
      <text style="font-size:12px;color:#085041;">课程表</text>
    </view>
  </view>
</view>
<nav-bar activeTab="home" items="{{navItems}}" />
