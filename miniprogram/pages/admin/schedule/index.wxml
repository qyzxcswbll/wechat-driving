<view class="page">
  <!-- 头部 -->
  <view class="header">📅 课程表</view>

  <!-- 日期条 + 月份跳转 -->
  <view class="date-section">
    <view class="date-top">
      <text class="week-label">📅 左右滑动查看更多日期</text>
      <picker mode="date" value="{{pickerDate}}" bindchange="onMonthPick">
        <view class="month-picker">📅 选择月份 ▾</view>
      </picker>
    </view>
    <scroll-view class="date-strip" scroll-x enhanced show-scrollbar="{{false}}" scroll-left="{{scrollLeft}}">
      <view wx:for="{{days}}" wx:key="date"
        class="date-card {{item.active?'active':''}} {{item.isToday?'today':''}}"
        bindtap="selectDay" data-date="{{item.date}}">
        <text class="dc-dow">{{item.dow}}</text>
        <text class="dc-day">{{item.day}}</text>
        <text class="dc-count" wx:if="{{item.count>0}}">{{item.count}}节</text>
        <text class="dc-count empty" wx:if="{{item.count===0}}">休</text>
      </view>
    </scroll-view>
  </view>

  <!-- 课程列表 -->
  <view class="course-section">
    <view class="selected-date">📅 {{selectedDate}} · {{dayTotal}}节课</view>

    <view wx:if="{{groupedSchedule.length===0}}" class="empty-state">
      <text class="empty-icon">📅</text>
      <text class="empty-text">当天暂无课程</text>
    </view>

    <view wx:for="{{groupedSchedule}}" wx:key="time" class="time-group">
      <view class="time-header">⏰ {{item.time}} <text class="time-count">{{item.students.length}}人</text></view>
      <view class="student-tag-wrap">
        <view wx:for="{{item.students}}" wx:key="_id" class="student-tag" bindtap="showDetail" data-item="{{item}}">
          <text class="tag-name">{{item.studentName || item.nickName || '学员'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 详情弹窗 -->
  <view wx:if="{{showModal}}" class="modal-mask" bindtap="closeModal">
    <view class="modal-box" catchtap="stopProp">
      <view class="modal-hd">📋 学员详情</view>
      <view class="modal-body">
        <view class="modal-row"><text class="ml">姓名</text><text class="mv">{{modalData.studentName || modalData.nickName || '未填'}}</text></view>
        <view class="modal-row"><text class="ml">电话</text><text class="mv">{{modalData.phone || '未填'}}</text></view>
        <view class="modal-row"><text class="ml">科目</text><text class="mv">{{modalData.subject}}</text></view>
        <view class="modal-row"><text class="ml">时间</text><text class="mv">{{modalData.date}} {{modalData.time}}</text></view>
        <view class="modal-row" wx:if="{{modalData.remark}}"><text class="ml">备注</text><text class="mv">{{modalData.remark}}</text></view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn call" wx:if="{{modalData.phone}}" bindtap="callStudent" data-phone="{{modalData.phone}}">📞 拨打电话</view>
        <view class="modal-btn close" bindtap="closeModal">关闭</view>
      </view>
    </view>
  </view>
</view>
<nav-bar activeTab="schedule" items="{{navItems}}" />
