<view class="page">
  <view class="stat-row">
    <view class="stat-card pending">
      <view class="stat-num">{{pendingCount}}</view>
      <view class="stat-lbl">待处理预约</view>
    </view>
    <view class="stat-card normal">
      <view class="stat-num">{{visitCount}}</view>
      <view class="stat-lbl">参观咨询</view>
    </view>
    <view class="stat-card normal">
      <view class="stat-num">{{confirmedCount}}</view>
      <view class="stat-lbl">已确认</view>
    </view>
  </view>

  <view class="menu-grid">
    <view class="menu-item" bindtap="goTo" data-url="../visits/index">
      <text class="menu-icon">🙋</text>
      <text class="menu-label">咨询学员</text>
    </view>
    <view class="menu-item" bindtap="goTo" data-url="../bookings/index">
      <text class="menu-icon">📋</text>
      <text class="menu-label">预约管理</text>
    </view>
    <view class="menu-item" bindtap="goTo" data-url="../schedule/index">
      <text class="menu-icon">📅</text>
      <text class="menu-label">课程表</text>
    </view>
  </view>
  <view class="notify-bar" bindtap="subscribeMsg">
    <text style="font-size:22rpx;">🔔 如未收到通知，点此重新授权</text>
  </view>
  <view class="setup-card" bindtap="goSetup">
    <text class="setup-icon">⚙️</text>
    <view class="setup-text">
      <view class="setup-title">管理设置</view>
      <view class="setup-desc">学员管理、驾校信息修改</view>
    </view>
    <text class="setup-arrow">›</text>
  </view>
</view>
<nav-bar activeTab="home" items="{{navItems}}" />
