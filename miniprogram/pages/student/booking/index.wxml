<view class="page" style="padding:16px 16px 70px;">
  <view class="card" style="background:#fff;border-radius:12px;padding:14px;border:1px solid #e8e8e8;">
    <view style="margin-bottom:14px;">
      <view style="font-size:12px;color:#888;margin-bottom:6px;">学车类型</view>
      <view style="display:flex;gap:8px;">
        <view style="flex:1;padding:10px;border-radius:8px;text-align:center;font-size:13px;{{subject==='科目二'?'background:#534AB7;color:#fff;':'background:#f8f8f8;color:#666;border:1px solid #e8e8e8;'}}" bindtap="setSubject" data-val="科目二">科目二</view>
        <view style="flex:1;padding:10px;border-radius:8px;text-align:center;font-size:13px;{{subject==='科目三'?'background:#534AB7;color:#fff;':'background:#f8f8f8;color:#666;border:1px solid #e8e8e8;'}}" bindtap="setSubject" data-val="科目三">科目三</view>
      </view>
    </view>
    <view>
      <view style="font-size:12px;color:#888;margin-bottom:6px;">备注（可选）</view>
      <input style="background:#fff;border:1px solid #ddd;border-radius:8px;padding:10px;font-size:14px;color:#333;width:100%;box-sizing:border-box;" placeholder="自动挡/手动挡？" bindinput="onRemarkInput" />
    </view>
  </view>

  <view style="font-size:15px;font-weight:500;color:#333;margin:16px 0 8px;">预约日期</view>

  <view wx:for="{{slots}}" wx:key="index" style="background:#fff;border-radius:12px;padding:14px;border:1px solid #e8e8e8;margin-bottom:10px;">
    <view style="display:flex;gap:8px;margin-bottom:8px;">
      <view style="flex:1;background:#f8f8f8;border:1px solid #e8e8e8;border-radius:8px;padding:10px;font-size:14px;color:#555;text-align:center;" bindtap="pickDate" data-index="{{index}}">📅 {{item.date || '选择日期'}}</view>
      <input style="flex:1;background:#fff;border:1px solid #ddd;border-radius:8px;padding:10px;font-size:14px;color:#333;width:100%;box-sizing:border-box;" placeholder="期望时间" value="{{item.time}}" bindinput="onTimeInput" data-index="{{index}}" />
    </view>
    <view style="display:flex;align-items:center;gap:8px;">
      <input style="flex:1;background:#fff;border:1px solid #ddd;border-radius:8px;padding:10px;font-size:14px;color:#333;width:100%;box-sizing:border-box;" placeholder="此日期的备注（可选）" value="{{item.remark}}" bindinput="onSlotRemark" data-index="{{index}}" />
      <view wx:if="{{slots.length>1}}" style="color:#A32D2D;font-size:12px;padding:10px;flex-shrink:0;" bindtap="removeSlot" data-index="{{index}}">删除</view>
    </view>
  </view>

  <view style="border:1.5px dashed #ccc;border-radius:10px;padding:12px;text-align:center;font-size:13px;color:#888;margin-bottom:16px;" bindtap="addSlot">+ 再添加一个日期</view>

  <view style="background:#534AB7;color:#fff;padding:16px;border-radius:10px;text-align:center;font-size:15px;font-weight:500;" bindtap="submit">一次性提交所有预约（{{slots.length}}节）</view>
</view>
