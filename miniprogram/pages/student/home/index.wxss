.page { padding: 32rpx 32rpx 140rpx; }
.hero { background: linear-gradient(135deg, #EEEDFE, #F8F7FF); border-radius: 28rpx; padding: 48rpx; text-align: center; margin-bottom: 32rpx; border: 2rpx solid #CECBF6; }
.hero-title { font-size: 44rpx; font-weight: 600; color: #3C3489; margin-bottom: 8rpx; }
.hero-sub { font-size: 28rpx; color: #7F77DD; }
.card { background: #fff; border-radius: 24rpx; padding: 28rpx; border: 2rpx solid #e8e8e8; margin-bottom: 24rpx; }
.info-row { display: flex; padding: 12rpx 0; font-size: 28rpx; }
.info-label { color: #888; width: 140rpx; flex-shrink: 0; }
.info-val { color: #333; }
.section-title { font-size: 30rpx; font-weight: 500; color: #333; margin-bottom: 16rpx; }
.intro-text { font-size: 28rpx; color: #555; line-height: 1.7; }
.menu-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.menu-item { width: calc(50% - 10rpx); background: #fff; border: 2rpx solid #e8e8e8; border-radius: 24rpx; padding: 36rpx 24rpx; text-align: center; box-sizing: border-box; }
.menu-icon { display: block; font-size: 56rpx; margin-bottom: 12rpx; }
.menu-label { font-size: 26rpx; color: #555; }
