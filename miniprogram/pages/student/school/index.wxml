<view class="page" style="padding:16px;">
  <view class="hero" style="background:linear-gradient(135deg,#EEEDFE,#F8F7FF);border-radius:14px;padding:24px;text-align:center;margin-bottom:16px;border:1px solid #CECBF6;">
    <view class="hero-title" style="font-size:22px;font-weight:600;color:#3C3489;margin-bottom:4px;">🚗 {{info.schoolName}}</view>
    <view class="hero-sub" style="font-size:14px;color:#7F77DD;">{{info.coachName}} · {{info.phone}}</view>
  </view>
  <view class="card" style="background:#fff;border-radius:12px;padding:14px;border:1px solid #e8e8e8;margin-bottom:12px;">
    <view class="section-title" style="font-size:15px;font-weight:500;color:#333;margin-bottom:8px;">📍 地址</view>
    <text style="font-size:14px;color:#555;line-height:1.7;">{{info.address}}</text>
  </view>
  <view class="card" style="background:#fff;border-radius:12px;padding:14px;border:1px solid #e8e8e8;margin-bottom:16px;">
    <view class="section-title" style="font-size:15px;font-weight:500;color:#333;margin-bottom:8px;">👨‍🏫 教练介绍</view>
    <text style="font-size:14px;color:#555;line-height:1.7;">{{info.intro}}</text>
  </view>
  <view style="display:flex;gap:10px;">
    <view style="flex:1;background:#534AB7;color:#fff;padding:14px;border-radius:10px;text-align:center;font-size:14px;font-weight:500;" bindtap="callPhone" data-phone="{{info.phone}}">📞 拨打电话</view>
    <view style="flex:1;background:#fff;color:#534AB7;padding:14px;border-radius:10px;text-align:center;font-size:14px;font-weight:500;border:1.5px solid #CECBF6;" bindtap="goVisit">📋 预约参观</view>
  </view>
</view>
