.badge {
  display: inline-flex;
  align-items: center;
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 4px;
}
.pending { background: #FAEEDA; color: #BA7517; }
.accepted { background: #E1F5EE; color: #0F6E56; }
.rejected { background: #FCEBEB; color: #A32D2D; }
.contacted { background: #E1F5EE; color: #0F6E56; }
