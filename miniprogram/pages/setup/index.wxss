.card { background: #fff; border-radius: 24rpx; padding: 32rpx; border: 2rpx solid #e8e8e8; width: 100%; box-sizing: border-box; }
.field { margin-bottom: 32rpx; width: 100%; }
.field-label { font-size: 24rpx; color: #888; margin-bottom: 12rpx; }
.field-input { background: #fff; border: 2rpx solid #ddd; border-radius: 16rpx; padding: 28rpx 28rpx; font-size: 28rpx; color: #333; display: block; width: 100%; box-sizing: border-box; min-height: 88rpx; }
.sect-title { font-size: 30rpx; font-weight: 500; color: #333; margin-bottom: 8rpx; }
.btn-primary { background: #534AB7; color: #fff; padding: 28rpx; border-radius: 20rpx; text-align: center; font-size: 30rpx; font-weight: 500; width: 100%; border: none; display: block; box-sizing: border-box; min-height: 88rpx; margin-top: 16rpx; }
.btn-primary::after { border: none; }
.set-btn { background: #E1F5EE; color: #0F6E56; padding: 12rpx 28rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 500; flex-shrink: 0; }
.upload-btn { background: #f0f0f0; color: #555; padding: 16rpx 24rpx; border-radius: 12rpx; font-size: 24rpx; border: none; flex-shrink: 0; }
.upload-btn::after { border: none; }