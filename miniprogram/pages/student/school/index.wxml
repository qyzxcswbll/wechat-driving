<view class="page">
  <view class="hero">
    <view class="hero-title">🚗 {{info.schoolName}}</view>
    <view class="hero-sub">{{info.coachName}} · {{info.phone}}</view>
  </view>
  <view class="card" bindtap="openMap" style="{{info.latitude?'cursor:pointer':''}}">
    <view class="section-title">📍 地址 <text wx:if="{{info.latitude}}" style="font-size:22rpx;color:#534AB7;font-weight:400;">导航 ›</text></view>
    <text class="body-text">{{info.address}}</text>
  </view>
  <view class="card">
    <view class="section-title">👨‍🏫 教练介绍</view>
    <text class="body-text">{{info.intro}}</text>
  </view>
  <view class="btn-row">
    <view class="btn-primary" bindtap="callPhone" data-phone="{{info.phone}}">📞 拨打电话</view>
    <view class="btn-secondary" bindtap="goVisit">📋 预约参观</view>
  </view>
</view>
