<view class="page">
  <view class="tab-bar">
    <view class="tab {{tab==='booking'?'on':''}}" bindtap="switchTab" data-tab="booking">上课预约</view>
    <view class="tab {{tab==='visit'?'on':''}}" bindtap="switchTab" data-tab="visit">参观咨询</view>
  </view>

  <!-- 上课预约列表 -->
  <view wx:if="{{tab==='booking'}}">
    <view wx:if="{{bookings.length===0}}" class="empty">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无上课预约记录</text>
    </view>
    <view wx:for="{{bookings}}" wx:key="_id" class="booking-card">
      <view class="booking-top" bindtap="goDetail" data-id="{{item._id}}">
        <text class="booking-date">{{item.date}} {{item.time}}</text>
        <status-badge status="{{item.status}}" />
      </view>
      <view class="booking-info" bindtap="goDetail" data-id="{{item._id}}">{{item.subject}}{{item.remark ? ' · ' + item.remark : ''}}</view>
      <view wx:if="{{item.status==='pending'}}" class="cancel-btn" bindtap="cancelBooking" data-id="{{item._id}}">取消预约</view>
    </view>
  </view>

  <!-- 参观咨询列表 -->
  <view wx:if="{{tab==='visit'}}">
    <view wx:if="{{visits.length===0}}" class="empty">
      <text class="empty-icon">🙋</text>
      <text class="empty-text">暂无参观咨询记录</text>
    </view>
    <view wx:for="{{visits}}" wx:key="_id" class="booking-card">
      <view class="booking-top">
        <text class="booking-date">参观咨询</text>
        <status-badge status="{{item.status}}" />
      </view>
      <view class="booking-info">📱 {{item.phone}}</view>
      <view wx:if="{{item.remark}}" class="booking-info">💬 {{item.remark}}</view>
      <view class="booking-time">🕐 {{item.createdAt}}</view>
    </view>
  </view>
  <view class="notify-bar" bindtap="subscribeMsg">🔔 如未收到通知，点此重新授权</view>
</view>
<nav-bar activeTab="my" items="{{navItems}}" />
