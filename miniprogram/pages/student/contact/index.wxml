<view class="page">
  <view class="card">
    <view class="coach-name">👨‍🏫 {{info.coachName}}</view>
    <image wx:if="{{info.wechatQR}}" class="qr-image" src="{{info.wechatQR}}" mode="widthFix" />
    <view wx:else class="qr-placeholder">微信二维码</view>
    <view class="hint">长按识别二维码添加微信</view>
    <view class="btn-copy" bindtap="copyWechat">📋 复制微信号</view>
    <button class="btn-feedback" open-type="contact" session-from="意见反馈">💬 联系客服</button>
  </view>
  <view class="card">
    <view class="btn-call" bindtap="callPhone" data-phone="{{info.phone}}">📞 拨打电话</view>
    <view wx:if="{{info.latitude && info.longitude}}" class="btn-map" bindtap="openMap">📍 导航到这里</view>
  </view>
</view>
