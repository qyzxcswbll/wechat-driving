.page { padding: 32rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 48rpx; border: 2rpx solid #e8e8e8; margin-bottom: 24rpx; text-align: center; }
.coach-name { font-size: 36rpx; font-weight: 500; color: #333; margin-bottom: 32rpx; }
.qr-image { width: 360rpx; border-radius: 16rpx; margin-bottom: 16rpx; }
.qr-placeholder { background: #f5f5f5; border-radius: 16rpx; padding: 80rpx; margin-bottom: 16rpx; color: #999; font-size: 26rpx; }
.hint { font-size: 24rpx; color: #888; margin-bottom: 32rpx; }
.btn-copy { background: #f8f8f8; border: 2rpx solid #e8e8e8; border-radius: 16rpx; padding: 20rpx; margin-bottom: 24rpx; text-align: center; font-size: 26rpx; }
.btn-feedback { background: #534AB7; color: #fff !important; border-radius: 16rpx; padding: 24rpx; text-align: center; font-size: 28rpx; width: 100%; border: none; }
.btn-feedback::after { border: none; }
.btn-call { background: #534AB7; color: #fff; padding: 28rpx; border-radius: 20rpx; text-align: center; font-size: 28rpx; font-weight: 500; }
