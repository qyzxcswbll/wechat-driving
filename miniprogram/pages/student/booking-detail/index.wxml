<view class="page">
  <view wx:if="{{info._id}}" class="card">
    <view class="detail-row">
      <text class="dl">状态</text>
      <status-badge status="{{info.status}}" />
    </view>
    <view class="detail-row">
      <text class="dl">日期</text>
      <text class="dv">{{info.date}}</text>
    </view>
    <view class="detail-row">
      <text class="dl">时间</text>
      <text class="dv">{{info.time}}</text>
    </view>
    <view class="detail-row">
      <text class="dl">科目</text>
      <text class="dv">{{info.subject}}</text>
    </view>
    <view wx:if="{{info.remark}}" class="detail-row">
      <text class="dl">备注</text>
      <text class="dv">{{info.remark}}</text>
    </view>
    <view wx:if="{{info.adminReply}}" class="detail-row">
      <text class="dl">回复</text>
      <text class="dv-reply">{{info.adminReply}}</text>
    </view>
    <view class="detail-row">
      <text class="dl">提交时间</text>
      <text class="dv">{{info.createdAt}}</text>
    </view>
  </view>
</view>
