.nav-bar {
  display: flex;
  background: #fff;
  border-top: 1px solid #e8e8e8;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.nav-item {
  flex: 1;
  padding: 6px 0;
  text-align: center;
  font-size: 10px;
  color: #999;
}
.nav-item.active { color: #534AB7; }
.icon { display: block; font-size: 20px; margin-bottom: 2px; }
.label { display: block; }
