.page { padding: 32rpx; width: 100%; box-sizing: border-box; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; border: 2rpx solid #e8e8e8; width: 100%; box-sizing: border-box; }
.field { margin-bottom: 40rpx; width: 100%; }
.field:last-child { margin-bottom: 0; }
.field-label { font-size: 24rpx; color: #888; margin-bottom: 12rpx; }
.field-label .required { color: #A32D2D; }
.name-row { display: flex; gap: 16rpx; align-items: center; }
.name-input { flex: 1; background: #fff; border: 2rpx solid #ddd; border-radius: 16rpx; padding: 32rpx 28rpx; font-size: 30rpx; color: #333; display: block; width: 100%; box-sizing: border-box; min-height: 96rpx; }
.gender-tag { padding: 20rpx 28rpx; border-radius: 14rpx; font-size: 26rpx; background: #f8f8f8; color: #666; border: 2rpx solid #e8e8e8; display: flex; align-items: center; flex-shrink: 0; }
.gender-tag.on { background: #534AB7; color: #fff; border-color: #534AB7; }
.field-input { background: #fff; border: 2rpx solid #ddd; border-radius: 16rpx; padding: 32rpx 28rpx; font-size: 30rpx; color: #333; display: block; width: 100%; box-sizing: border-box; min-height: 96rpx; }
.field-text { background: #f8f8f8; border: 2rpx solid #e8e8e8; border-radius: 16rpx; padding: 32rpx 28rpx; font-size: 30rpx; color: #555; width: 100%; box-sizing: border-box; min-height: 96rpx; display: flex; align-items: center; }
.pill-group { display: flex; gap: 16rpx; width: 100%; }
.pill { flex: 1; padding: 28rpx; border-radius: 16rpx; text-align: center; font-size: 28rpx; background: #f8f8f8; color: #666; border: 2rpx solid #e8e8e8; min-height: 88rpx; display: flex; align-items: center; justify-content: center; }
.pill.on { background: #534AB7; color: #fff; border-color: #534AB7; }
.section-title { font-size: 30rpx; font-weight: 500; color: #333; margin: 40rpx 0 20rpx; }
.slot-card { background: #fff; border-radius: 24rpx; padding: 28rpx; border: 2rpx solid #e8e8e8; margin-bottom: 24rpx; width: 100%; box-sizing: border-box; }
.slot-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; width: 100%; }
.picker-btn { flex: 1; background: #f8f8f8; border: 2rpx solid #ddd; border-radius: 16rpx; padding: 28rpx 20rpx; font-size: 26rpx; color: #333; text-align: center; min-height: 88rpx; display: flex; align-items: center; justify-content: center; }
.slot-remark-row { display: flex; align-items: center; gap: 16rpx; width: 100%; }
.slot-remark-row .field-input { flex: 1; padding: 24rpx 28rpx; min-height: 96rpx; }
.slot-del { color: #A32D2D; font-size: 24rpx; flex-shrink: 0; padding: 20rpx 0; }
.add-slot { border: 3rpx dashed #ccc; border-radius: 20rpx; padding: 28rpx; text-align: center; font-size: 28rpx; color: #888; margin-bottom: 40rpx; width: 100%; box-sizing: border-box; }
.btn-primary { background: #534AB7; color: #fff; padding: 32rpx; border-radius: 20rpx; text-align: center; font-size: 30rpx; font-weight: 500; width: 100%; border: none; display: block; box-sizing: border-box; min-height: 96rpx; line-height: 1.2; }
.btn-primary::after { border: none; }
.btn-primary.btn-disabled { background: #ccc; }
.privacy-row { margin-top: 24rpx; padding: 24rpx 0; }
.privacy-checkbox { display: flex; align-items: center; gap: 12rpx; }
.check-box { width: 32rpx; height: 32rpx; border-radius: 6rpx; border: 2rpx solid #ccc; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #fff; flex-shrink: 0; }
.check-box.checked { background: #534AB7; border-color: #534AB7; }
.privacy-text { font-size: 24rpx; color: #666; }
.privacy-link { color: #534AB7; text-decoration: underline; }
.hint { font-size: 24rpx; color: #aaa; margin-top: 12rpx; }
