<view class="page">
  <view class="filter-bar">
    <picker mode="selector" range="{{filters}}" value="{{filterIdx}}" bindchange="onFilter">
      <view class="filter-text">📋 {{filters[filterIdx]}} ▾</view>
    </picker>
  </view>

  <view wx:for="{{displayList}}" wx:key="_id" class="mcard mcard-{{item.status}}">
    <view class="mcard-top">
      <text class="mcard-name">{{item.nickName}} · {{item.subject}}</text>
      <status-badge status="{{item.status}}" />
    </view>
    <view class="mcard-info">📅 {{item.date}} {{item.time}}</view>
    <view class="mcard-info">📱 {{item.phone}}</view>
    <view wx:if="{{item.remark}}" class="mcard-info">💬 {{item.remark}}</view>

    <view wx:if="{{item.status==='pending'}}" class="action-row">
      <view class="abtn abtn-accept" bindtap="acceptBooking" data-id="{{item._id}}">✓ 接受</view>
      <view class="abtn abtn-reject" bindtap="rejectBooking" data-id="{{item._id}}">✗ 拒绝</view>
      <view class="abtn abtn-wx" bindtap="callPhone" data-phone="{{item.phone}}">💬 微信</view>
    </view>
    <view wx:elif="{{item.status==='rejected' && item.adminReply}}" class="mcard-reply">
      原因：{{item.adminReply}}
    </view>
  </view>
</view>
<nav-bar activeTab="bookings" items="{{navItems}}" />
