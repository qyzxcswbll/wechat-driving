.splash {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #fff;
}
.splash-icon { font-size: 48px; margin-bottom: 12px; }
.splash-title { font-size: 20px; font-weight: 500; color: #3C3489; margin-bottom: 8px; }
.splash-sub { font-size: 14px; color: #888; }
