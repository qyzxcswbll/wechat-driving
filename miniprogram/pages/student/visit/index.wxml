<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">姓名 <text class="required">*</text></view>
      <view class="name-row">
        <input class="name-input" placeholder="您的姓名" value="{{studentName}}" bindinput="onNameInput" />
        <view class="gender-tag {{gender==='先生'?'on':''}}" bindtap="setGender" data-val="先生">先生</view>
        <view class="gender-tag {{gender==='女士'?'on':''}}" bindtap="setGender" data-val="女士">女士</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">手机号 <text class="required">*</text></view>
      <input class="field-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="field">
      <view class="field-label">备注（可选）</view>
      <input class="field-input" placeholder="有什么想了解的？" bindinput="onRemarkInput" />
    </view>
  </view>
  <button class="btn-primary" bindtap="submit">提交参观申请</button>
  <view class="hint">提交后教练会主动联系您约时间参观</view>
</view>
